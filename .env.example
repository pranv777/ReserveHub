# Copy to .env (repo root). Read by docker compose. Example values only; never commit real secrets.
# For running backend/frontend directly use backend/.env and frontend/.env (see their .env.example).

# --- Supabase Auth ---
# Local (npx supabase start): API http://127.0.0.1:54321 ; issuer http://127.0.0.1:54321/auth/v1
# Cloud: project URL https://<ref>.supabase.co ; issuer https://<ref>.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://YOUR-PROJECT-REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=
JWT_AUDIENCE=authenticated
JWT_ISSUER=https://YOUR-PROJECT-REF.supabase.co/auth/v1
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key

# --- App ---
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
VITE_API_BASE_URL=http://localhost:8000

# --- docker-compose.yml (optional fallback: plain Postgres container) ---
POSTGRES_USER=reservehub
POSTGRES_PASSWORD=reservehub
POSTGRES_DB=reservehub
