# Used when you run the backend directly (cd backend && uvicorn ...). Copy to backend/.env.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local Supabase (npx supabase start; confirm with `npx supabase status`):
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
# Plain Postgres container (docker compose up -d db):
#   postgresql+psycopg://reservehub:reservehub@localhost:5432/reservehub
# Supabase cloud (copy from Dashboard > Connect; use the pooler string on Render):
#   postgresql://postgres.<ref>:<password>@<pooler-host>:5432/postgres
# postgres:// and postgresql:// URLs are accepted; the app switches them to the psycopg driver.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
CORS_ORIGINS=http://localhost:5173

# Supabase Auth: set ONE of the two.
# Local default signs with an HS256 secret shown by `npx supabase status` (JWT secret):
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
# Cloud / asymmetric keys: https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
JWT_AUDIENCE=authenticated
JWT_ISSUER=http://127.0.0.1:54321/auth/v1
